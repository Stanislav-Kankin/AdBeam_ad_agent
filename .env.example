APP_MODE=production
YANDEX_DISCOVER_CLIENTS=true
# Empty: clients are visible only in allowed personal chats of administrators.
# Set explicit globally allowed chat IDs to share the full agency client list.
YANDEX_CLIENT_CHAT_IDS=[]
# mock and production always have separate databases (unless explicitly overridden).
# DATABASE_URL=sqlite+aiosqlite:///./data/adbeam_mock.db
CLIENTS_CONFIG=config/clients.yaml
TELEGRAM_BOT_TOKEN=
# JSON arrays; configure BOTH this allowlist and each client's allowed_chat_ids.
TELEGRAM_ALLOWED_CHAT_IDS=[123456789]
TELEGRAM_ADMIN_USER_IDS=[]
# Optional user allowlist, checked in addition to chat/client permissions.
TELEGRAM_ALLOWED_USER_IDS=[]
HISTORY_RETENTION_DAYS=90
WAREHOUSE_ENABLED=true
WAREHOUSE_BACKFILL_DAYS=30
WAREHOUSE_INTERVAL_SECONDS=120
# Direct-only detail pages. Jobs share a lock, so they do not overlap snapshot collection.
WAREHOUSE_DIMENSION_INTERVAL_SECONDS=30
# Model API calls per chat per UTC day; retries inside the provider are separate.
DEEPSEEK_DAILY_LIMIT=100
TELEGRAM_REPORT_CHAT_ID=123456789
SCHEDULE_ENABLED=true
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0
# Optional mock-only interval for testing instead of daily cron; 0 disables it.
MOCK_SCHEDULE_INTERVAL_SECONDS=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DIRECT_OAUTH_TOKEN=
METRICA_OAUTH_TOKEN=
ROISTAT_API_KEY=
LOG_LEVEL=INFO
