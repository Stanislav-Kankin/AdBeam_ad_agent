APP_MODE=mock
# mock and production always have separate databases (unless explicitly overridden).
# DATABASE_URL=sqlite+aiosqlite:///./data/adbeam_mock.db
CLIENTS_CONFIG=config/clients.yaml
TELEGRAM_BOT_TOKEN=
# JSON arrays; configure BOTH this allowlist and each client's allowed_chat_ids.
TELEGRAM_ALLOWED_CHAT_IDS=[123456789]
TELEGRAM_ADMIN_USER_IDS=[]
TELEGRAM_REPORT_CHAT_ID=123456789
SCHEDULE_ENABLED=true
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0
# Optional mock-only interval for testing instead of daily cron; 0 disables it.
MOCK_SCHEDULE_INTERVAL_SECONDS=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DIRECT_OAUTH_TOKEN=
METRICA_OAUTH_TOKEN=
ROISTAT_API_KEY=
LOG_LEVEL=INFO
